# Firebase client config for the frontend
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Firebase admin config for backend token verification
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"

# Service account credentials (pilih salah satu):
# Opsi 1: Path ke file service account key
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Opsi 2: Paste JSON content langsung
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# App URL
APP_URL="https://your-app-name.vercel.app"
