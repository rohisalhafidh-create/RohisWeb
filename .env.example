# Konfigurasi Web App Firebase (Firebase Console > Project settings > Your apps)
# Nilai VITE_* bersifat publik dan memang dikirim ke browser.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_WEB_APP_ID"
VITE_ADMIN_EMAILS="rohisalhafidh@gmail.com"

# Hanya email berikut yang dapat menjalankan perubahan pada API admin.
# Gunakan huruf kecil dan pisahkan beberapa email dengan koma.
ADMIN_EMAILS="rohisalhafidh@gmail.com"

# Supabase database (server-only; jangan gunakan service role key di frontend)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Verifikasi token Firebase Admin di backend
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
# Development lokal: path absolut ke file service-account JSON yang BARU dirotasi.
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/rotated-service-account.json"
# Production (mis. Vercel): isi environment variable ini dengan JSON service-account
# baru dalam satu baris. Jangan commit file atau nilai ini ke Git.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
